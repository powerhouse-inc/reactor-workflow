  },
  "dependencies": {
    "@activepieces/pieces-common": "0.12.5",
    "@activepieces/pieces-framework": "0.32.0",
    "@activepieces/shared": "0.95.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@powerhousedao/reactor-connectors": "workspace:*",
    "@types/node": "^24.13.3",
    "esbuild": "0.28.2",
    "oxlint": "1.70.0",
    "oxlint-tsgolint": "0.23.0",
    "typescript": "5.9.3",
    "vitest": "4.1.1"
  },
  "publishConfig": { "access": "public" },
  "license": "MIT"
