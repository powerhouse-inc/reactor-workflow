{
  "name": "@powerhousedao/piece-docling",
  "version": "1.0.0",
  "description": "Activepieces piece for Docling (docling-serve v1): convert documents to Markdown, docling-document JSON, HTML, DocTags and plain text.",
  "type": "module",
