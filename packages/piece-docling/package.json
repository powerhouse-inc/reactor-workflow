{
  "name": "@powerhousedao/piece-docling",
  "version": "1.0.0",
  "description": "Piece for Docling (docling-serve v1): convert documents to Markdown, docling-document JSON, HTML, DocTags and plain text.",
  "type": "module",
  "exports": {
    ".": {
      "source": "./index.ts",
      "types": "./dist/types/index.d.ts",
      "node": "./dist/node/index.mjs"
    },
    "./pieces": {
      "source": "./pieces/index.ts",
      "types": "./dist/types/pieces/index.d.ts",
      "node": "./dist/node/pieces/index.mjs"
    },
    "./pieces/*": {
      "source": "./pieces/*/index.ts",
      "types": "./dist/types/pieces/*/index.d.ts",
      "node": "./dist/node/pieces/*/index.mjs"
    },
    "./manifest": "./dist/powerhouse.manifest.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/build-piece.mjs",
    "test": "pnpm run build && vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "oxlint --type-aware --type-check --fix",
    "tsc": "tsc -p tsconfig.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "powerhouse",
    "pieces",
    "activepieces",
    "docling",
    "documents"
  ],
  "license": "MIT",
  "dependencies": {
    "@powerhousedao/pieces-framework": "6.2.3-dev.12",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@powerhousedao/reactor-workflow": "6.2.3-dev.12",
    "@types/node": "^24.13.3",
    "oxlint": "1.70.0",
    "oxlint-tsgolint": "0.23.0",
    "typescript": "5.9.3",
    "vitest": "4.1.1"
  }
}
