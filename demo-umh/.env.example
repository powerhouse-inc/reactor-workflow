# Copy to demo-umh/.env and fill in. The seed reads this file, so a key set
# here survives a re-run; nothing here reaches git (.env is ignored).
#
# The extraction step needs a credential and nothing else does: the floor API
# has no auth, and the paperless token is minted by the seed from the admin
# login in docker-compose.yml.

# OpenRouter, as in the umh-powerhouse demo. The seed mints this into the
# reactor's secret store and puts only the ref on the connection document, so
# the key itself is never readable back over any API — unlike an env var on a
# switchboard, which every process on the box can read.
PAPERLESS_AI_API_KEY=

# Any OpenRouter model id. The demo's default; a cheaper model extracts a
# purchase order perfectly well.
#PAPERLESS_AI_MODEL=openai/gpt-oss-120b

# Where the demo's services are, if you moved them.
#PAPERLESS_URL=http://localhost:18000
#PAPERLESS_USER=admin
#PAPERLESS_PASSWORD=paperless-demo
#UMH_API_URL=http://localhost:18081
#REACTOR_URL=http://localhost:4001
