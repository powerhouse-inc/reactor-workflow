# Mounted into the paperless image's s6-rc service directories as
# `environment` files (demo/docker-compose.yml). The image passes the
# container env to its services through s6's with-contenv import of
# /run/s6/container_environment, which is materialized once at container
# start; when that comes up empty (observed after a container
# recreation), Django boots with all default settings and API token
# authentication breaks (POST /api/token/ mints, GET /api/user/1/
# accepts, GET /api/documents/ answers 401 "Invalid token." forever).
# This file is the s6-rc-designed belt-and-suspenders: every PAPERLESS_*
# the stack needs, right where the service definitions live.
#
# Keep PAPERLESS_URL in sync with the compose file's published port (and with
# the connection's base_url) if you move it. The container always listens on
# 8000; only the host-side port changes.
PAPERLESS_URL=http://localhost:18000
PAPERLESS_REDIS=redis://paperless-broker:6379
PAPERLESS_TIME_ZONE=UTC
PAPERLESS_OCR_LANGUAGE=eng
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=paperless-demo
PAPERLESS_ADMIN_MAIL=admin@example.com
PAPERLESS_SECRET_KEY=demo-only-not-a-real-secret
PAPERLESS_WEBHOOKS_ALLOW_INTERNAL_REQUESTS=true
